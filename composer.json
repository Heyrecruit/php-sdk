{
  "name": "werbeagentur_artrevolver/scope-php-sdk",
  "description": "PHP SDK for implementing Heyrecruit with rest api.",
  "homepage": "https://heyrecruit.de",
  "keywords": [
    "scope",
    "recruiting",
    "artrevolver",
    "scope-recruiting",
    "heyrecruit",
    "ats"
  ],
  "license": "WTFPL",
  "authors": [
    {
      "name": "Oleg Mutzenberger",
      "email": "oleg@heyrecruit.de"
    },
    {
      "name": "Heyrecruit",
      "homepage": "https://heyrecruit.de"
    }
  ],
  "type": "library",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Heyrecruit\\": "src/Heyrecruit"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Heyrecruit\\Test\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
