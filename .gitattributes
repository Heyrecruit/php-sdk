# Ab 3.0 liegen alle Dateien mit LF im Repo. Ohne diese Regel normalisiert eine
# Arbeitskopie mit core.autocrlf=true beim Commit und erzeugt Diffs ueber jede Zeile.
* text=auto eol=lf

# Nicht ausliefern - haelt das Composer-Paket klein.
/tests export-ignore
/phpunit.xml export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
